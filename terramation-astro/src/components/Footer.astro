---
import NewsletterForm from "./NewsletterForm.astro";

interface Props {
  showFooterSignup?: boolean;
}

const { showFooterSignup = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">

    {showFooterSignup && (
      <div class="site-footer__signup">
        <div class="site-footer__signup-inner">
          <div class="site-footer__signup-intro">
            <h3 class="site-footer__signup-heading">Close the Circle</h3>
            <p class="site-footer__signup-sub">Stay updated on the campaign to legalise human composting in the UK.</p>
          </div>
          <div class="site-footer__signup-form">
            <NewsletterForm
              variant="inline"
              heading="Sign up for campaign updates"
              dark={true}
            />
          </div>
        </div>
      </div>
    )}

    <div class="site-footer__grid">

      <!-- Brand -->
      <div>
        <div class="site-footer__brand-lockup">
          <img
            src="/images/2023/03/Terramation-UK-768x71.png"
            alt="Terramation UK"
            class="site-footer__brand-logo"
            width="768"
            height="71"
          />
          <p class="site-footer__brand-tag">THE HOME OF HUMAN COMPOSTING IN THE UK</p>
        </div>
        <p class="site-footer__tagline">
          Championing human composting and sustainable end-of-life choices in the United Kingdom.
          Our Close&nbsp;the&nbsp;Circle campaign is working to make terramation legal for everyone.
        </p>
      </div>

      <!-- Pages -->
      <div>
        <h4>Pages</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/2023/03/21/what-is-terramation/">What is Terramation?</a></li>
          <li><a href="/find-sustainable-funerals/">Find Sustainable Funerals</a></li>
          <li><a href="/advertise/">Advertise</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <!-- Campaign -->
      <div>
        <h4>Close the Circle</h4>
        <ul>
          <li><a href="/blog/">Latest news</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="mailto:info@terramation.uk">info@terramation.uk</a></li>
        </ul>

        <hr class="site-footer__divider" />

        <h4>Register your interest</h4>
        <ul>
          <li><a href="/register-interest/">Be first to know when it's legal</a></li>
        </ul>
      </div>

    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">
        &copy; {year} Terramation UK. All rights reserved.
      </p>
      <p class="site-footer__copy">
        Human composting &amp; natural end-of-life education.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer__signup {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-block-end: var(--space-10);
    margin-block-end: var(--space-10);
  }

  .site-footer__signup-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-10);
  }

  .site-footer__signup-intro {
    flex: 0 0 auto;
    max-width: 260px;
  }

  .site-footer__signup-heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-sage-light);
    margin-block-end: var(--space-2);
  }

  .site-footer__signup-sub {
    font-size: var(--text-sm);
    color: rgba(237, 232, 222, 0.7);
    line-height: 1.5;
    margin: 0;
  }

  .site-footer__signup-form {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .site-footer__signup-inner {
      flex-direction: column;
      gap: var(--space-6);
    }

    .site-footer__signup-intro {
      max-width: none;
    }
  }
</style>
